    '[#1 ]', ), ), technique=BOTTOM_UP)
mdb.meshEditOptions.setValues(enableUndo=True, maxUndoCacheElements=0.5)
mdb.models['Model-1'].parts['P_1x1x1'].setMeshControls(elemShape=TET, regions=
    mdb.models['Model-1'].parts['P_1x1x1'].cells.getSequenceFromMask(('[#1 ]', 
    ), ), technique=FREE)
mdb.models['Model-1'].parts['P_1x1x1'].setElementType(elemTypes=(ElemType(
