    , geometryFile=mdb.acis, mergeSolidRegions=True, name='P_1x1x1', type=
    DEFORMABLE_BODY)
mdb.models['Model-1'].Material(name='Material-1')
mdb.models['Model-1'].materials['Material-1'].Density(table=((7.85e-09, ), ))
